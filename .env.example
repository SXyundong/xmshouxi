# Docker Compose 部署时的环境变量（复制为 .env 使用）
# 生产环境必须配置 DeepSeek Key；本地如需演示回复，可显式打开 mock
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_VISION_MODEL=deepseek-v4-flash-vision-exp
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MOCK_ENABLED=false
AIGC_MAX_IMAGE_COUNT=9
AIGC_MAX_IMAGE_BYTES=10485760
AIGC_MAX_TOTAL_IMAGE_BYTES=31457280
FEISHU_SSO_REQUIRED=false
WORKFLOW_AUTH_URL=https://ergolife-feishu-workflow-production.up.railway.app
AGENT_SSO_SHARED_SECRET=
FEISHU_SESSION_SECRET=
POSTGRES_DB=ecommerce_agent
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ecommerce:ecommerce@localhost:5432/ecommerce_agent
DB_ECHO=false
LINGXING_MCP_URL=https://openmcp.lingxing.com/mcp-servers/lingxing-mcp
LINGXING_MCP_KEY=
# Docker 只挂载桌面专用测试目录；网络路径写入保持关闭
HOST_STOCK_WORKBOOK_DIRECTORY=C:/Users/Administrator/Desktop/物流工作流测试3
HOST_LOGISTICS_CACHE_DIRECTORY=C:/Users/Administrator/Desktop/物流工作流测试
STOCK_WORKBOOK_PATH=/workbook/备货逻辑看板表.xlsx
LOGISTICS_SALES_DB_PATH=/data/logistics_sales.sqlite3
LOGISTICS_INITIAL_SYNC_DAYS=60
LOGISTICS_LOOKBACK_DAYS=30
# Optional override for the bundled full-format workbook template.
# LOGISTICS_EXPORT_TEMPLATE_PATH=/app/templates/备货逻辑看板表.xlsx
NETWORK_WORKBOOK_WRITE_ENABLED=false
